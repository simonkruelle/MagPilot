<?xml version="1.0"?>
<!--
  colmag_arm_nodes.launch — start BOTH arm-side nodes in one terminal:

    colmag_draw_node    teleoperation (cursor-following, gripper, rotation,
                        magnet-height → EE height); homes the arm on teleop exit
    colmag_robot_node   discrete gesture motions (letters → tricks,
                        digits 1-8 → cube corners, 9 → center); homes on startup when
                        teleop is not active

  The two nodes coordinate over the latched /colmag/draw_active topic, so the
  start order and timing never matter: while teleop owns the arm, gestures and
  startup homing are suspended.

  Usage (inside the colmag_ros container, next to fr3.launch):
    roslaunch colmag_ros colmag_arm_nodes.launch dry_run:=false
    # Panda instead of the FR3:
    roslaunch colmag_ros colmag_arm_nodes.launch dry_run:=false arm_id:=panda
-->
<launch>

  <arg name="arm_id"         default="fr3"   doc="Joint prefix: fr3 or panda"/>
  <arg name="dry_run"        default="true"  doc="true = log only, do not move the arm"/>
  <arg name="arm_controller" default="effort_joint_trajectory_controller"
       doc="JointTrajectoryController both nodes drive"/>
  <arg name="time_scale"     default="2.0"   doc="Gesture motion time multiplier (robot node)"/>
  <arg name="home_on_start"  default="true"  doc="Robot node: home the arm at startup (skipped while teleop is active)"/>
  <arg name="home_on_exit"   default="true"  doc="Draw node: home the arm when exiting teleop"/>
  <arg name="digit_cube_size" default="0.24" doc="Digit target cube edge length (m)"/>
  <arg name="digit_cube_center_x" default="0.45" doc="Digit cube center X in the robot base frame (m)"/>
  <arg name="digit_cube_center_y" default="0.0" doc="Digit cube center Y in the robot base frame (m)"/>
  <arg name="digit_cube_center_z" default="0.40" doc="Digit cube center Z in the robot base frame (m)"/>
  <arg name="height_sensor_min" default="0.007" doc="Minimum magnet height over sensors (m), including board offset"/>
  <arg name="height_sensor_max" default="0.150" doc="Magnet height mapped to the workspace top (m)"/>
  <arg name="height_gain"       default="2.0"   doc="Saturating height gain; reduces sensitivity near the upper range"/>
  <arg name="height_smoothing_tau" default="0.25" doc="Robot-only magnet height low-pass time constant near the board (s)"/>
  <arg name="height_smoothing_tau_far" default="0.65" doc="Robot-only magnet height low-pass time constant at the top of the range (s); heavier where the sensor is least certain"/>
  <arg name="height_noise_deadband" default="0.001" doc="Robot-only ignored height noise band (m)"/>
  <arg name="target_smoothing_tau" default="0.04" doc="Robot-only cursor target low-pass time constant (s)"/>
  <arg name="max_linear_speed" default="0.12" doc="MagPilot Cartesian S-curve speed limit (m/s)"/>
  <arg name="max_linear_acceleration" default="0.30" doc="MagPilot Cartesian S-curve acceleration limit (m/s^2)"/>
  <arg name="max_linear_jerk" default="1.50" doc="MagPilot Cartesian S-curve jerk limit (m/s^3)"/>
  <arg name="s_curve_min_duration" default="0.50" doc="Minimum MagPilot S-curve planning horizon (s)"/>
  <arg name="height_ee_min"     default="0.121" doc="Minimum flange target z (m), approximately 1 mm fingertip clearance"/>
  <arg name="height_ee_max"     default="0.680" doc="Maximum flange target z (m)"/>
  <arg name="lift_gate_z"       default="0.150" doc="Pause following above this magnet height (m)"/>
  <arg name="lift_gate_hysteresis" default="0.010" doc="Height below lift gate required to resume (m)"/>

  <!-- Teleoperation: cursor following, gripper, wrist rotation, height. -->
  <node pkg="colmag_ros"
        type="colmag_draw_node.py"
        name="colmag_draw_node"
        output="screen">
    <param name="arm_id"         value="$(arg arm_id)"/>
    <param name="dry_run"        value="$(arg dry_run)"/>
    <param name="arm_controller" value="$(arg arm_controller)"/>
    <param name="home_on_exit"   value="$(arg home_on_exit)"/>
    <param name="height_sensor_min" value="$(arg height_sensor_min)"/>
    <param name="height_sensor_max" value="$(arg height_sensor_max)"/>
    <param name="height_gain"       value="$(arg height_gain)"/>
    <param name="height_smoothing_tau" value="$(arg height_smoothing_tau)"/>
    <param name="height_smoothing_tau_far" value="$(arg height_smoothing_tau_far)"/>
    <param name="height_noise_deadband" value="$(arg height_noise_deadband)"/>
    <param name="target_smoothing_tau" value="$(arg target_smoothing_tau)"/>
    <param name="max_linear_speed" value="$(arg max_linear_speed)"/>
    <param name="max_linear_acceleration" value="$(arg max_linear_acceleration)"/>
    <param name="max_linear_jerk" value="$(arg max_linear_jerk)"/>
    <param name="s_curve_min_duration" value="$(arg s_curve_min_duration)"/>
    <param name="height_ee_min"     value="$(arg height_ee_min)"/>
    <param name="height_ee_max"     value="$(arg height_ee_max)"/>
    <param name="lift_gate_z"       value="$(arg lift_gate_z)"/>
    <param name="lift_gate_hysteresis" value="$(arg lift_gate_hysteresis)"/>
  </node>

  <!-- Discrete gesture motions (letters/digits). -->
  <node pkg="colmag_ros"
        type="colmag_robot_node.py"
        name="colmag_robot_node"
        output="screen">
    <param name="arm_id"         value="$(arg arm_id)"/>
    <param name="dry_run"        value="$(arg dry_run)"/>
    <param name="arm_controller" value="$(arg arm_controller)"/>
    <param name="time_scale"     value="$(arg time_scale)"/>
    <param name="home_on_start"  value="$(arg home_on_start)"/>
    <param name="digit_cube_size" value="$(arg digit_cube_size)"/>
    <param name="digit_cube_center_x" value="$(arg digit_cube_center_x)"/>
    <param name="digit_cube_center_y" value="$(arg digit_cube_center_y)"/>
    <param name="digit_cube_center_z" value="$(arg digit_cube_center_z)"/>
  </node>

</launch>
