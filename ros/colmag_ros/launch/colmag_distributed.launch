<launch>
  <!--
    colmag_distributed.launch — full distributed pipeline

    Node topology (input:=magnetometer):
      colmag_sensor_node     reads serial → /colmag/sensor_data, /colmag/pose
      colmag_classifier_node subscribes to /colmag/pose
                             → /colmag/classifier, /colmag/confidence
      colmag_joystick_node   subscribes to /colmag/pose + classifier
                             → /colmag/command
      colmag_robot_node      subscribes to /colmag/command
                             → robot actions (implement execute_command())
      rosbridge_websocket    WebSocket bridge so the Mac visualiser can
                             subscribe/publish without a native ROS install

    Node topology (input:=touchpad, the default):
      The touchpad UI publishes /colmag/{sensor_data, pose, command, classifier,
      confidence} itself, so the sensor/classifier/joystick nodes are skipped and
      only colmag_robot_node + rosbridge start here. Run the interactive UI in
      its own terminal:
        python3 magnetometer_reader.py [with the touchpad input source and ROS
        publishing enabled; see the Stage 6 command in the README]

    Usage:
      roslaunch colmag_ros colmag_distributed.launch
      # Real magnetometer over serial instead of the touchpad:
      roslaunch colmag_ros colmag_distributed.launch input:=magnetometer port:=/dev/ttyUSB0
      # Skip the robot node during development:
      roslaunch colmag_ros colmag_distributed.launch run_robot:=false
  -->

  <!-- ── Global arguments ─────────────────────────────────────────────────── -->
  <arg name="input"        default="touchpad" doc="Gesture input: 'touchpad' (run magnetometer_reader.py separately) or 'magnetometer' (serial sensor + classifier + joystick nodes)"/>
  <arg name="port"         default=""       doc="Serial port (auto-detect if empty; input:=magnetometer only)"/>
  <arg name="baudrate"     default="921600" doc="Serial baud rate (input:=magnetometer only)"/>
  <arg name="verbose"      default="false"  doc="Log every packet from sensor_node"/>
  <arg name="height_sensor_bias" default="0.010" doc="Bias subtracted from raw magnet height (m)"/>
  <arg name="run_robot"       default="true"   doc="Start the robot node"/>
  <arg name="dry_run"         default="true"   doc="Robot node: log only, do not move"/>
  <arg name="arm_id"          default="fr3"    doc="Robot node: joint prefix '&lt;arm_id&gt;_joint1..7' (fr3 or panda)"/>
  <arg name="arm_controller"  default="effort_joint_trajectory_controller" doc="Robot node: JointTrajectoryController to drive"/>
  <arg name="time_scale"      default="2.0"    doc="Robot node: multiplies all motion waypoint times; 1.0 restores the original Gazebo-tuned speed"/>
  <arg name="action_map_file" default="/colmag/config/robot_actions.json"
       doc="Validated character-to-tested-action mapping shared with the GUI"/>
  <arg name="digit_cube_size" default="0.24" doc="Digit target cube edge length (m)"/>
  <arg name="digit_cube_center_x" default="0.45" doc="Digit cube center X (m)"/>
  <arg name="digit_cube_center_y" default="0.0" doc="Digit cube center Y (m)"/>
  <arg name="digit_cube_center_z" default="0.40" doc="Digit cube center Z (m)"/>

  <!-- ── 1. Sensor node — the ONLY node that reads the serial port ────────── -->
  <node pkg="colmag_ros"
        type="colmag_sensor_node.py"
        name="colmag_sensor_node"
        output="screen"
        if="$(eval input == 'magnetometer')">
    <param name="port"     value="$(arg port)"/>
    <param name="baudrate" value="$(arg baudrate)"/>
    <param name="verbose"  value="$(arg verbose)"/>
    <param name="height_sensor_bias" value="$(arg height_sensor_bias)"/>
  </node>

  <!-- ── 2. Classifier node — swap this to use your own model ────────────── -->
  <node pkg="colmag_ros"
        type="colmag_classifier_node.py"
        name="colmag_classifier_node"
        output="screen"
        if="$(eval input == 'magnetometer')">
    <param name="image_size"        value="64"/>
    <param name="projection_extent" value="0.05"/>
    <param name="idle_seconds"      value="0.8"/>
    <param name="min_velocity"      value="0.04"/>
    <param name="min_ink_samples"   value="8"/>
    <!-- Uncomment to suppress ink when magnet is farther than 5 cm: -->
    <!-- <param name="writing_max_z"  value="0.05"/> -->
  </node>

  <!-- ── 3. Joystick node — swap this to change the interaction model ─────── -->
  <node pkg="colmag_ros"
        type="colmag_joystick_node.py"
        name="colmag_joystick_node"
        output="screen"
        if="$(eval input == 'magnetometer')">
    <param name="dwell_seconds"     value="1.5"/>
    <param name="projection_extent" value="0.05"/>
    <param name="letter_labels"     value="ABCDEFGHIJKLMNOPQRSTUVWXYZ" type="str"/>
    <param name="digit_labels"      value="0123456789"                  type="str"/>
  </node>

  <!-- ── 4. Robot node — implement execute_command() here ────────────────── -->
  <node pkg="colmag_ros"
        type="colmag_robot_node.py"
        name="colmag_robot_node"
        output="screen"
        if="$(arg run_robot)">
    <param name="dry_run"         value="$(arg dry_run)"/>
    <param name="arm_id"          value="$(arg arm_id)"/>
    <param name="arm_controller"  value="$(arg arm_controller)"/>
    <param name="time_scale"      value="$(arg time_scale)"/>
    <param name="digit_cube_size" value="$(arg digit_cube_size)"/>
    <param name="digit_cube_center_x" value="$(arg digit_cube_center_x)"/>
    <param name="digit_cube_center_y" value="$(arg digit_cube_center_y)"/>
    <param name="digit_cube_center_z" value="$(arg digit_cube_center_z)"/>
    <param name="action_map_file" value="$(arg action_map_file)"/>
    <!-- <param name="robot_ip" value="192.168.1.100"/> -->
  </node>

  <!-- ── rosbridge WebSocket — lets the Mac visualiser connect over port 9090 -->
  <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch">
    <arg name="port" value="9090"/>
  </include>

</launch>
