<?xml version="1.0"?>
<!--
  colmag_draw.launch — "draw in the air" Cartesian teleoperation mode.

  The end-effector follows the cursor/magnet on a plane in front of the robot
  (see colmag_draw_node.py). This launch starts the draw node, the gesture
  robot node, rosbridge, and (for the real magnetometer) the serial sensor
  node — so BOTH modes work in one session: the Teleop button enables
  following, the Letters/Digits buttons switch back to classified gestures
  (colmag_robot_node executes them; it suspends itself while teleop is
  active). The touchpad UI, if used, is run separately and publishes
  /colmag/pose plus the classifier/command topics itself.

  SAFETY: dry_run defaults to true and motion is gated by /colmag/draw_enable.
  Rehearse in Gazebo (fr3.launch) before driving the real arm via fr3_real.launch.

  Usage:
    # Gazebo rehearsal from the touchpad (no real robot):
    roslaunch colmag_ros fr3.launch controller:=effort_joint_trajectory_controller
    roslaunch colmag_ros colmag_draw.launch dry_run:=false
    (run magnetometer_reader.py with the touchpad source and ROS on; see README)
    rostopic pub -1 /colmag/draw_enable std_msgs/Bool "data: true"

    # Real magnetometer with the full Matplotlib UI / tilt+twist controls:
    roslaunch colmag_ros colmag_draw.launch dry_run:=false
    Run magnetometer_reader.py in serial ROS mode; see README for the command.
-->
<launch>
  <arg name="input"          default="touchpad" doc="Gesture input: 'touchpad' (run magnetometer_reader.py separately) or 'magnetometer' (serial sensor node)"/>
  <arg name="port"           default=""       doc="Serial port (magnetometer input only)"/>
  <arg name="baudrate"       default="921600" doc="Serial baud rate (magnetometer input only)"/>
  <arg name="height_sensor_bias" default="0.010" doc="Bias subtracted from raw magnet height (m)"/>
  <arg name="dry_run"        default="true"   doc="Draw node: log targets/IK residuals but do not move"/>
  <arg name="arm_id"         default="fr3"    doc="Joint prefix '&lt;arm_id&gt;_joint1..7'"/>
  <arg name="arm_controller" default="effort_joint_trajectory_controller" doc="JointTrajectoryController to stream to (Gazebo default; use position_joint_trajectory_controller on the real FR3)"/>
  <arg name="run_robot"      default="true"   doc="Also start colmag_robot_node so Letters/Digits gestures execute"/>
  <arg name="time_scale"     default="2.0"    doc="Robot node: multiplies gesture waypoint times (see colmag_distributed.launch)"/>
  <arg name="digit_cube_size" default="0.24" doc="Digit target cube edge length (m)"/>
  <arg name="digit_cube_center_x" default="0.45" doc="Digit cube center X (m)"/>
  <arg name="digit_cube_center_y" default="0.0" doc="Digit cube center Y (m)"/>
  <arg name="digit_cube_center_z" default="0.40" doc="Digit cube center Z (m)"/>
  <arg name="start_enabled"  default="false"  doc="Follow immediately on start (else wait for the Teleop button / /colmag/draw_enable)"/>
  <arg name="plane_orientation" default="horizontal" doc="'horizontal' (tabletop in the air) or 'vertical' (upright canvas)"/>
  <arg name="plane_center_x" default="0.45"   doc="Drawing-plane centre X in the robot base frame (m)"/>
  <arg name="plane_center_y" default="0.0"    doc="Drawing-plane centre Y (m)"/>
  <arg name="plane_center_z" default="0.40"   doc="Drawing-plane centre Z (m); FLANGE height — fingertips are ~0.1-0.16 m lower with the hand"/>
  <arg name="plane_width"    default="0.60"   doc="Workspace box Y extent (m)"/>
  <arg name="plane_depth"    default="0.30"   doc="Workspace box X extent (m)"/>
  <arg name="plane_height"   default="0.56"   doc="Workspace box Z extent (m); default box bottom puts fingertips at ~base height for pick-ups"/>
  <arg name="max_joint_step" default="0.05"   doc="Max per-joint change per update (rad); secondary safety clamp"/>
  <arg name="max_linear_speed" default="0.10" doc="Cartesian tool-speed cap (m/s); the target glides toward the cursor at this rate"/>
  <arg name="max_linear_acceleration" default="0.20" doc="Cartesian S-curve acceleration limit (m/s^2)"/>
  <arg name="max_linear_jerk" default="0.80" doc="Cartesian S-curve jerk limit (m/s^3)"/>
  <arg name="s_curve_min_duration" default="0.75" doc="Minimum S-curve planning horizon (s)"/>
  <arg name="height_sensor_min" default="0.007" doc="Minimum magnet height over sensors (m), including board offset"/>
  <arg name="height_sensor_max" default="0.150" doc="Magnet height mapped to the workspace top (m)"/>
  <arg name="height_gain"       default="2.0"   doc="Saturating gain that reduces sensitivity at uncertain high distances"/>
  <arg name="height_smoothing_tau" default="0.35" doc="Robot-only magnet height low-pass time constant (s)"/>
  <arg name="height_noise_deadband" default="0.001" doc="Robot-only ignored height noise band (m)"/>
  <arg name="height_ee_min"     default="0.121" doc="Minimum flange target z (m), approximately 1 mm fingertip clearance"/>
  <arg name="height_ee_max"     default="0.680" doc="Maximum flange target z (m)"/>
  <arg name="lift_gate_z"       default="0.150" doc="Pause teleop following above this measured magnet height (m)"/>
  <arg name="lift_gate_hysteresis" default="0.010" doc="Resume only after |pose.z| falls this far below lift_gate_z"/>
  <arg name="grasp_force"    default="20.0"   doc="Gripper grasp force (N); raise for heavier/slippery objects (hand max 70)"/>

  <!-- Serial sensor node — only when using the real magnetometer. -->
  <node pkg="colmag_ros"
        type="colmag_sensor_node.py"
        name="colmag_sensor_node"
        output="screen"
        if="$(eval input == 'magnetometer')">
    <param name="port"     value="$(arg port)"/>
    <param name="baudrate" value="$(arg baudrate)"/>
    <param name="height_sensor_bias" value="$(arg height_sensor_bias)"/>
  </node>

  <!-- Cartesian draw / teleop node. -->
  <node pkg="colmag_ros"
        type="colmag_draw_node.py"
        name="colmag_draw_node"
        output="screen">
    <param name="dry_run"         value="$(arg dry_run)"/>
    <param name="arm_id"          value="$(arg arm_id)"/>
    <param name="arm_controller"  value="$(arg arm_controller)"/>
    <param name="start_enabled"   value="$(arg start_enabled)"/>
    <param name="plane_orientation" value="$(arg plane_orientation)"/>
    <param name="plane_width"     value="$(arg plane_width)"/>
    <param name="plane_depth"     value="$(arg plane_depth)"/>
    <param name="plane_height"    value="$(arg plane_height)"/>
    <param name="plane_center_x"  value="$(arg plane_center_x)"/>
    <param name="plane_center_y"  value="$(arg plane_center_y)"/>
    <param name="plane_center_z"  value="$(arg plane_center_z)"/>
    <param name="max_joint_step"  value="$(arg max_joint_step)"/>
    <param name="max_linear_speed" value="$(arg max_linear_speed)"/>
    <param name="max_linear_acceleration" value="$(arg max_linear_acceleration)"/>
    <param name="max_linear_jerk" value="$(arg max_linear_jerk)"/>
    <param name="s_curve_min_duration" value="$(arg s_curve_min_duration)"/>
    <param name="height_sensor_min" value="$(arg height_sensor_min)"/>
    <param name="height_sensor_max" value="$(arg height_sensor_max)"/>
    <param name="height_gain"       value="$(arg height_gain)"/>
    <param name="height_smoothing_tau" value="$(arg height_smoothing_tau)"/>
    <param name="height_noise_deadband" value="$(arg height_noise_deadband)"/>
    <param name="height_ee_min"     value="$(arg height_ee_min)"/>
    <param name="height_ee_max"     value="$(arg height_ee_max)"/>
    <param name="lift_gate_z"     value="$(arg lift_gate_z)"/>
    <param name="lift_gate_hysteresis" value="$(arg lift_gate_hysteresis)"/>
    <param name="grasp_force"     value="$(arg grasp_force)"/>
  </node>

  <!-- Gesture robot node — executes classified letters/digits when NOT in
       teleop (it ignores confirmed gestures while teleop is active). -->
  <node pkg="colmag_ros"
        type="colmag_robot_node.py"
        name="colmag_robot_node"
        output="screen"
        if="$(arg run_robot)">
    <param name="dry_run"         value="$(arg dry_run)"/>
    <param name="arm_id"          value="$(arg arm_id)"/>
    <param name="arm_controller"  value="$(arg arm_controller)"/>
    <param name="time_scale"      value="$(arg time_scale)"/>
    <param name="digit_cube_size" value="$(arg digit_cube_size)"/>
    <param name="digit_cube_center_x" value="$(arg digit_cube_center_x)"/>
    <param name="digit_cube_center_y" value="$(arg digit_cube_center_y)"/>
    <param name="digit_cube_center_z" value="$(arg digit_cube_center_z)"/>
  </node>

  <!-- rosbridge WebSocket — lets the Mac touchpad UI connect over port 9090. -->
  <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch">
    <arg name="port" value="9090"/>
  </include>
</launch>
